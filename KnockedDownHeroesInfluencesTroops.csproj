<Project Sdk="Microsoft.NET.Sdk;Bannerlord.BuildResourcesLite.Sdk/1.2.3.41">

	<PropertyGroup>
		<Version>1.5.7.0</Version>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ModuleId>$(MSBuildProjectName)</ModuleId>
		<ModuleName>Knocked Down Heroes Influences Troops</ModuleName>
		<ModuleUrl>https://www.nexusmods.com/mountandblade2bannerlord/mods/7955</ModuleUrl>
		<AssemblyName>$(ModuleId).v$(GameVersion)</AssemblyName>
		<BuildForWindowsStore>true</BuildForWindowsStore>
		<DefineConstants>$(DefineConstants);v$(GameVersion.Replace('.',''))</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Bannerlord.MCM" Version="5.13.1" IncludeAssets="compile" />
		<PackageReference Include="Bannerlord.ModuleLoader.Injector" Version="1.0.1.50" PrivateAssets="all" />
	</ItemGroup>

</Project>
